FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN pip install --no-cache-dir uv
WORKDIR /srv
COPY packages/core /srv/packages/core
COPY apps/avis-clients /srv/apps/avis-clients
RUN uv pip install --system -e /srv/packages/core -e /srv/apps/avis-clients
WORKDIR /srv/apps/avis-clients
RUN mkdir -p data
EXPOSE 8000
CMD ["uvicorn", "avis_clients.web:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
