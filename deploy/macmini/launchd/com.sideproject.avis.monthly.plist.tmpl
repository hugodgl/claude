<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sideproject.avis.monthly</string>
  <key>ProgramArguments</key>
  <array>
      <string>/bin/bash</string>
      <string>__REPO__/deploy/macmini/run.sh</string>
      <string>avis-clients</string>
      <string>avis</string>
      <string>monthly-report</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer><key>Day</key><integer>1</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/logs/launchd-com.sideproject.avis.monthly.out</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/launchd-com.sideproject.avis.monthly.err</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin</string></dict>
</dict>
</plist>
