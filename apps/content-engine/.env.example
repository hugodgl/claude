# ------------------------------------------------------------------
# content-engine : copier en .env (jamais commité) et compléter.
# Toutes les publications restent en dry-run tant que `--live` n'est pas passé.
# ------------------------------------------------------------------

# --- LLM (hérité de packages/core) ---
LLM_PROVIDER=ollama            # mock | ollama | anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_THINK=false
LLM_TIMEOUT_S=180
# ANTHROPIC_API_KEY=            # lue par le SDK Anthropic si LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# --- Dossiers ---
DATA_DIR=data                  # base SQLite, jetons OAuth
OUT_DIR=out                    # rendus vidéo, exports de relecture, dry-run de publication
TOPICS_FILE=topics.yaml
ASSETS_DIR=assets              # images de fond optionnelles : assets/<produit>.jpg
TIMEZONE=Europe/Paris

# --- Marque et pages de capture ---
BRAND_NAME=@moncompte          # affiché en bas des vidéos
LANDING_URL_AVIS=https://example.com/avis
LANDING_URL_MARCHES=https://example.com/marches
LANDING_URL_CABINETS=https://example.com/cabinets
AI_DISCLOSURE=Contenu créé avec l'aide d'IA, relu par un humain.   # vide → valeur par défaut

# --- Voix (TTS) ---
TTS_PROVIDER=say               # say (macOS) | kokoro | elevenlabs | silent (tests)
SAY_VOICE=Thomas               # `say -v '?' | grep fr_` : Thomas, Amélie, Audrey…
SAY_RATE=175                   # mots par minute
# KOKORO_MODEL_PATH=data/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=data/voices-v1.0.bin
# KOKORO_VOICE=ff_siwis
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS_SILENT_DURATION_S=       # durée fixe pour le fournisseur silent (tests, aperçus)

# --- Vidéo ---
# FONT_PATH=/System/Library/Fonts/Supplemental/Arial Bold.ttf   # défaut : DejaVu Sans Bold si présente ; fichier absent → rendu refusé
VIDEO_CODEC=libx264            # h264_videotoolbox sur Mac (plus rapide, accélération matérielle)
VIDEO_PRESET=medium            # libx264 uniquement
VIDEO_CRF=20                   # libx264 uniquement
VIDEO_MAX_SECONDS=60

# --- YouTube Data API v3 (OAuth « application de bureau ») ---
YOUTUBE_CLIENT_SECRETS_FILE=data/youtube-client-secret.json
YOUTUBE_TOKEN_FILE=data/youtube-token.json
YOUTUBE_PRIVACY_STATUS=private # private | unlisted | public : vérifier la première vidéo avant de passer en public
YOUTUBE_CATEGORY_ID=27         # 27 = Éducation, 22 = People & Blogs

# --- Pinterest API v5 ---
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_BOARD_ID=
PINTEREST_API_BASE=https://api.pinterest.com

# --- LinkedIn Posts API ---
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:organization:123456   # ou urn:li:person:xxxx
LINKEDIN_VERSION=202510        # en-tête LinkedIn-Version (AAAAMM), à rafraîchir tous les ~6 mois
LINKEDIN_API_BASE=https://api.linkedin.com

# --- TikTok Content Posting API (audit de l'app requis avant publication publique) ---
# TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY # SELF_ONLY | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | PUBLIC_TO_EVERYONE
TIKTOK_APP_AUDITED=false       # tant que false, la visibilité est forcée à SELF_ONLY (audit Content Posting)
TIKTOK_API_BASE=https://open.tiktokapis.com
