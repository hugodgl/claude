# ---- Veille marchés : copier en .env (jamais commité) ----

# LLM (voir packages/core) : mock dans les tests, ollama en local par défaut, anthropic en option
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_THINK=false
LLM_TIMEOUT_S=180
# ANTHROPIC_API_KEY=            # requis seulement si LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
LLM_ENABLED=true                 # false = score par règles seulement (utile au premier essai)
LLM_MAX_NOTICES_PER_RUN=200      # garde-fou de coût / durée par passage de `vm score`

# Email : console (affiche), smtp, resend
MAIL_PROVIDER=console
MAIL_FROM=Veille marchés <veille@example.com>
REPLY_TO=hugo@example.com        # adresse qui reçoit les réponses des abonnés
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# RESEND_API_KEY=

# Données
DATA_DIR=data
DB_PATH=data/veille-marches.db
OUT_DIR=data/out                 # aperçus HTML/texte des digests (vm digest sans --send)

# Produit
PRODUCT_NAME=Veille marchés
TRADE_LABEL=entreprises d'espaces verts et paysagistes
DEFAULT_CPV_PREFIXES=773         # préfixes CPV collectés quand aucun abonné actif (séparés par des virgules)
PRIORITY_THRESHOLD=70            # score à partir duquel un avis est « à regarder en priorité »
DIGEST_LOOKBACK_DAYS=7           # un avis plus ancien que N jours n'entre plus dans un digest
MATCH_UNKNOWN_DEPARTMENT=false   # true = un avis sans département connu est proposé à tous les abonnés CPV
SOURCE_LABEL=Côté Marchés        # signature en pied d'email

# Collecte
COLLECT_SINCE_DAYS=2
COLLECT_LIMIT=500                # nombre maximal d'enregistrements par source et par passage
HTTP_TIMEOUT_S=30
HTTP_USER_AGENT=veille-marches/0.1 (+contact: hugo@example.com)

# BOAMP (Opendatasoft, DILA) : pas de clé nécessaire pour les volumes du MVP
BOAMP_BASE_URL=https://boamp-datadila.opendatasoft.com/api/explore/v2.1
BOAMP_DATASET=boamp
# BOAMP_API_KEY=                 # optionnel (quota plus élevé)
BOAMP_SERVER_SIDE_CPV=false      # true = ajoute un filtre texte CPV dans la clause where (à valider en réel)

# TED (Union européenne, API v3) : la recherche fonctionne sans clé ; TED_API_KEY est optionnelle
TED_BASE_URL=https://api.ted.europa.eu/v3
# TED_API_KEY=
TED_COUNTRY=FRA
TED_PAGE_SIZE=100

# DECP (attributions) : miroir Opendatasoft de data.economie.gouv.fr
DECP_BASE_URL=https://data.economie.gouv.fr/api/explore/v2.1
DECP_DATASET=decp-v3             # alternatives : decp-v3-marches-valides, decp_augmente
