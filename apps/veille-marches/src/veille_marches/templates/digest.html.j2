<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2937;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;overflow:hidden;">
  <tr><td style="background:#14532d;color:#ffffff;padding:20px 24px;">
    <div style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.85;">{{ settings.product_name }}</div>
    <div style="font-size:22px;font-weight:700;margin-top:4px;">Vos marchés du {{ date_label }}</div>
    <div style="font-size:15px;margin-top:8px;opacity:.95;">
      Bonjour {{ digest.subscriber.display_name }}, {{ digest.total }} nouveau{{ 'x' if digest.total > 1 }} avis
      {% if digest.subscriber.departments %}pour les départements {{ digest.subscriber.departments|join(', ') }}{% else %}pour toute la France{% endif %}
      {% if digest.subscriber.cpv_prefixes %}(CPV {{ digest.subscriber.cpv_prefixes|join(', ') }}){% endif %}.
    </div>
  </td></tr>

  {% macro card(item, compact=False) %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:8px;margin:0 0 14px 0;">
    <tr><td style="padding:14px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
        <td style="font-size:17px;font-weight:700;line-height:1.3;color:#111827;">
          <a href="{{ item.notice.url }}" style="color:#14532d;text-decoration:none;">{{ item.notice.title }}</a>
        </td>
        <td align="right" valign="top" style="width:56px;">
          <span style="display:inline-block;background:{{ item.score|score_color }};color:#fff;border-radius:14px;padding:4px 10px;font-size:14px;font-weight:700;">{{ item.score }}</span>
        </td>
      </tr></table>
      <div style="font-size:14px;color:#4b5563;margin-top:6px;">
        {{ item.notice.buyer_name or 'Acheteur non précisé' }}
        {% if item.notice.all_departments %} · dép. {{ item.notice.all_departments|join(', ') }}{% endif %}
        · {{ item.notice.source|upper }}
      </div>
      <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:10px;font-size:15px;">
        <tr><td style="padding:2px 12px 2px 0;color:#6b7280;">Montant</td><td style="font-weight:600;">{{ item.notice.estimated_amount|fr_amount }}</td></tr>
        <tr><td style="padding:2px 12px 2px 0;color:#6b7280;">Date limite</td><td style="font-weight:600;">{{ item.notice.deadline_at|fr_date(true) }}{% if item.days_left is not none %} ({{ item.days_left }} j){% endif %}</td></tr>
        {% if item.notice.procedure_type %}<tr><td style="padding:2px 12px 2px 0;color:#6b7280;">Procédure</td><td>{{ item.notice.procedure_type }}</td></tr>{% endif %}
        {% if item.summary.lieu and item.summary.lieu != 'non précisé' %}<tr><td style="padding:2px 12px 2px 0;color:#6b7280;">Lieu</td><td>{{ item.summary.lieu }}</td></tr>{% endif %}
      </table>
      {% if not compact %}
      <p style="font-size:15px;line-height:1.5;margin:12px 0 0 0;">{{ item.summary.resume }}</p>
      {% if item.summary.pieces_a_fournir %}
      <div style="font-size:14px;margin-top:10px;"><strong>Pièces à fournir :</strong>
        <ul style="margin:4px 0 0 0;padding-left:20px;">{% for p in item.summary.pieces_a_fournir %}<li>{{ p }}</li>{% endfor %}</ul>
      </div>
      {% endif %}
      {% if item.summary.criteres and item.summary.criteres != 'non précisés' %}
      <div style="font-size:14px;margin-top:8px;"><strong>Critères :</strong> {{ item.summary.criteres }}</div>
      {% endif %}
      {% if item.llm_used %}
      <div style="font-size:14px;margin-top:8px;"><strong>Avis de l'assistant :</strong>
        {% if item.summary.verdict == 'oui' %}oui, à étudier{% elif item.summary.verdict == 'non' %}plutôt non{% else %}peut-être{% endif %}{% if item.summary.raison %} — {{ item.summary.raison }}{% endif %}</div>
      {% endif %}
      {% endif %}
      {% if item.flags %}
      <div style="margin-top:10px;">
        {% for f in item.flags %}<span style="display:inline-block;background:#f3f4f6;color:#374151;border-radius:4px;padding:2px 8px;font-size:12px;margin:0 6px 4px 0;">{{ f }}</span>{% endfor %}
      </div>
      {% endif %}
      <div style="margin-top:12px;"><a href="{{ item.notice.url }}" style="display:inline-block;background:#14532d;color:#fff;text-decoration:none;border-radius:6px;padding:8px 14px;font-size:14px;font-weight:600;">Voir l'avis original</a></div>
    </td></tr>
  </table>
  {% endmacro %}

  <tr><td style="padding:20px 24px 4px 24px;">
    {% if digest.priority %}
    <h2 style="font-size:18px;margin:0 0 12px 0;color:#14532d;">À regarder en priorité <span style="font-weight:400;color:#6b7280;font-size:14px;">(score ≥ {{ threshold }})</span></h2>
    {% for item in digest.priority %}{{ card(item) }}{% endfor %}
    {% endif %}
    {% if digest.others %}
    <h2 style="font-size:18px;margin:8px 0 12px 0;color:#374151;">Autres marchés</h2>
    {% for item in digest.others %}{{ card(item, compact=True) }}{% endfor %}
    {% endif %}
  </td></tr>

  <tr><td style="padding:12px 24px 24px 24px;font-size:13px;color:#6b7280;line-height:1.5;border-top:1px solid #e5e7eb;">
    <p style="margin:12px 0 0 0;"><strong>Résumé assisté par IA : vérifiez toujours l'avis original</strong> (dates, montants et pièces) avant de préparer une réponse. Le lien vers la source figure sous chaque marché.</p>
    <p style="margin:8px 0 0 0;">Pour modifier vos départements, vos codes CPV ou votre fourchette de montant, ou pour vous désabonner : {% if account_url %}<a href="{{ account_url }}" style="color:#14532d;">votre espace</a> (lien personnel valable {{ settings.account_link_days }} jours) ou répondez{% else %}répondez simplement{% endif %} à cet email.</p>
    <p style="margin:8px 0 0 0;">{{ settings.source_label }} · Sources : BOAMP (DILA), TED (Union européenne).</p>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
