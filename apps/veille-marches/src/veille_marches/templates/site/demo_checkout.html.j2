{% extends "site/base.html.j2" %}
{% block title %}Paiement simulé — {{ settings.product_name }}{% endblock %}
{% block content %}
<h1>Paiement simulé</h1>
<div class="flash warn">Cette page remplace Stripe Checkout tant que <code>STRIPE_SECRET_KEY</code> n'est pas renseignée. Aucun paiement réel n'a lieu : le bouton ci-dessous joue le rôle du webhook <code>checkout.session.completed</code>.</div>
<div class="card" style="max-width:560px">
  <table class="recap">
    <tr><td>Abonné</td><td>{{ sub.company or sub.email }}<br><span class="muted small">{{ sub.email }}</span></td></tr>
    <tr><td>Formule</td><td>{{ recap.plan_name }} · {{ recap.period_label }} · <strong>{{ recap.price_label }}</strong></td></tr>
    <tr><td>Codes CPV</td><td>{{ recap.cpv }}</td></tr>
    <tr><td>Départements</td><td>{{ recap.departments|join(', ') }}</td></tr>
    <tr><td>Montants</td><td>{{ recap.amount_range }}</td></tr>
  </table>
  {% if sub.active %}<p class="flash">Cet abonnement est déjà actif.</p>{% endif %}
  <form method="post" action="/demo/checkout/{{ sub.id }}">
    <button class="btn" type="submit">Simuler un paiement réussi</button>
    <a class="btn secondary" href="/inscription">Annuler</a>
  </form>
</div>
{% endblock %}
