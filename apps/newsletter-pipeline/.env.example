# Copier en `.env` (jamais commité). Tout est optionnel : les valeurs ci-dessous sont les défauts.

# --- LLM (socle commun) -------------------------------------------------------------------
LLM_PROVIDER=ollama              # mock | ollama | anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_THINK=false
LLM_TIMEOUT_S=180
# ANTHROPIC_API_KEY=             # si LLM_PROVIDER=anthropic (lu par le SDK)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# --- Identité de la newsletter ------------------------------------------------------------
NEWSLETTER_NAME=L'IA en cabinet
NEWSLETTER_TAGLINE=Chaque mardi, ce que l'IA change pour votre cabinet, en 5 minutes.
AUTHOR_NAME=Hugo
AUTHOR_SIGNATURE=Hugo                      # pied de page : « relue et signée par un humain : Hugo »
# REPLY_TO_EMAIL=hugo@exemple.fr
# ARCHIVE_URL=https://exemple.beehiiv.com

# --- Fichiers et dossiers (relatifs au dossier de l'app) ----------------------------------
DATA_DIR=data                    # base SQLite : data/newsletter.db
DB_NAME=newsletter.db
ISSUES_DIR=issues
OUT_DIR=out
# SOURCES_FILE=sources.yaml      # défaut : sources.yaml à la racine de l'app
# STYLE_FILE=style.md
# CASES_DIR=cases
# SPONSOR_FILE=sponsor.yaml

# --- Collecte -----------------------------------------------------------------------------
REQUEST_DELAY_S=1.5              # délai de politesse entre deux requêtes HTTP
HTTP_TIMEOUT_S=20
USER_AGENT=newsletter-pipeline/0.1 (+veille IA cabinets comptables ; contact : hugo@exemple.fr)
MAX_LINKS_PER_PAGE=8             # articles suivis par source de type `page` et par passage
RSS_FETCH_PAGES=false            # true : télécharge l'article complet derrière chaque entrée RSS
MAX_CONTENT_CHARS=20000          # texte stocké par item
MAX_PAGE_BYTES=5000000           # taille max d'une réponse HTTP (flux ou page) ; au-delà, la source est en erreur

# --- Classement ---------------------------------------------------------------------------
RANK_BATCH_SIZE=5                # items par appel LLM
RANK_MAX_CHARS=1500              # extrait envoyé au modèle par item
WEIGHT_PERTINENCE=0.5
WEIGHT_ACTIONNABLE=0.3
WEIGHT_NOUVEAUTE=0.2
RANK_DEFAULT_LIMIT=60

# --- Sélection ----------------------------------------------------------------------------
ISSUE_ITEMS=8
MAX_PER_THEME=2
MAX_PER_SOURCE=3
MAX_ITEM_AGE_DAYS=14             # 0 = pas de filtre d'ancienneté

# --- Push ---------------------------------------------------------------------------------
# BEEHIIV_API_KEY=               # clé API (Settings → Integrations → API) ; requis pour --live
# BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx
BEEHIIV_BASE_URL=https://api.beehiiv.com/v2
# BEEHIIV_CONTENT_TAGS=["ia","cabinets"]
# KESSEL_PUBLICATION_URL=https://www.kessel.media/ma-newsletter
