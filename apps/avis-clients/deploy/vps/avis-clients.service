# /etc/systemd/system/avis-clients.service : serveur web (VPS Debian/Ubuntu).
[Unit]
Description=Avis Clients (web)
After=network.target

[Service]
User=avis
WorkingDirectory=/srv/avis-clients/apps/avis-clients
EnvironmentFile=/srv/avis-clients/apps/avis-clients/.env
ExecStart=/srv/avis-clients/apps/avis-clients/.venv/bin/gunicorn avis_clients.web:app \
  -k uvicorn.workers.UvicornWorker -w 2 -b 127.0.0.1:8000 --forwarded-allow-ips="127.0.0.1" --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
