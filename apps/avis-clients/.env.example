# ---- Application -------------------------------------------------------------------------
APP_NAME="Avis Clients"
APP_BASE_URL=http://localhost:8000          # URL publique (https://avis.exemple.fr en production)
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire   # python -c "import secrets;print(secrets.token_hex(32))" ; obligatoire (≥ 32 caractères) dès que APP_BASE_URL est en https
DATA_DIR=data                               # base SQLite, jeton Google, état du mock
# DB_PATH=data/avis-clients.db
TRIAL_DAYS=14
TRIAL_SMS_QUOTA=10
APP_TIMEZONE=Europe/Paris                   # mois des quotas et des rapports, affichage des dates
SUPPORT_EMAIL=contact@exemple.fr

# ---- LLM (voir packages/core) : mock | ollama | anthropic --------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Email (voir packages/core) : console | smtp | resend --------------------------------
MAIL_PROVIDER=console
MAIL_FROM="Avis Clients <noreply@exemple.fr>"
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Stripe (clés de test d'abord : sk_test_..., whsec_..., price_...) --------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_RESEAU=

# ---- SMS : dry-run | smsmode | twilio ---------------------------------------------------------
SMS_PROVIDER=dry-run
SMS_SENDER=AvisClients                      # émetteur alphanumérique, 11 caractères max
SMS_WEBHOOK_TOKEN=                          # jeton exigé par /webhooks/sms/inbound (?token=…) ; indispensable avec smsmode, Twilio est vérifié par signature
SMSMODE_API_KEY=
SMSMODE_API=rest                            # rest (https://rest.smsmode.com/sms/v1/messages) | http16 (sendSMS.do)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                                # +33… numéro Twilio
TWILIO_WHATSAPP_FROM=                       # whatsapp:+14155238886 (sandbox) ou numéro WhatsApp Business

# ---- Google Business Profile : mock | live ---------------------------------------------------
GBP_MODE=mock
# GBP_FIXTURES_FILE=src/avis_clients/fixtures/gbp_reviews.json
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=           # fichier JSON « application de bureau » téléchargé depuis Google Cloud
# GOOGLE_TOKEN_FILE=data/google_token.json  # écrit par `avis google auth`

# ---- Facebook (Graph API) : mock | live ------------------------------------------------------------
FACEBOOK_MODE=mock                          # live : jeton de Page longue durée saisi par établissement (réglages ou `avis sources link`)
# FACEBOOK_FIXTURES_FILE=src/avis_clients/fixtures/facebook_ratings.json
FACEBOOK_GRAPH_VERSION=v21.0

# ---- Tripadvisor (Content API, lecture seule : pas de réponse par API) : mock | live -----------------
TRIPADVISOR_MODE=mock
TRIPADVISOR_API_KEY=                        # clé Content API (portail développeur Tripadvisor, IP du serveur autorisée)
TRIPADVISOR_POLL_INTERVAL_MIN=360           # quota mensuel limité : une lecture par fiche toutes les 6 h au plus
# TRIPADVISOR_FIXTURES_FILE=src/avis_clients/fixtures/tripadvisor_reviews.json

# ---- Chiffrement des jetons de plateforme stockés en base (obligatoire en FACEBOOK_MODE=live) ------
TOKENS_KEY=                                 # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ; distincte de SESSION_SECRET

# ---- Réponses aux avis ------------------------------------------------------------------------
REPLY_MAX_WORDS=60
ALERT_MAX_RATING=2                          # alerte email immédiate pour les avis ≤ 2 étoiles
AUTO_PUBLISH_MIN_RATING=4                   # seuil de l'option d'auto-publication (désactivée par défaut)
